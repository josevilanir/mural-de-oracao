# ─── Banco de Dados ─────────────────────────────────────────────────────────
# Neon PostgreSQL — obtenha em: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="seu-secret-aqui"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Configure em: https://console.cloud.google.com
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# Configure em: https://app.brevo.com
BREVO_API_KEY="xkeysib-..."
BREVO_FROM_EMAIL="noreply@domain.com"
BREVO_FROM_NAME="Mural de Oracao"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Configure em: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="AY..."

# ─── Armazenamento de Imagens (Cloudflare R2) ────────────────────────────────
# Configure em: https://dash.cloudflare.com
CLOUDFLARE_R2_ACCOUNT_ID="your_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_access_key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_secret_key"
CLOUDFLARE_R2_BUCKET_NAME="your_bucket_name"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-..."

# ─── Error Tracking (Sentry) ─────────────────────────────────────────────────
# Configure em: https://sentry.io
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
