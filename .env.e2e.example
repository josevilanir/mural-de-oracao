# Credenciais do usuário de teste para os testes E2E com Playwright.
# Copie para .env.e2e.local e preencha com valores reais.
#
# O setup automático (global.setup.ts) tentará fazer login com estas credenciais.
# Se o usuário não existir, ele será criado automaticamente via /register.

E2E_TEST_NAME="Teste E2E"
E2E_TEST_EMAIL="e2e.test@mural.dev"
E2E_TEST_PASSWORD="Test@12345"

# URL base da aplicação (padrão: http://localhost:3000)
PLAYWRIGHT_BASE_URL="http://localhost:3000"
